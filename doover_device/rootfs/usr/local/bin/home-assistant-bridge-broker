#!/usr/bin/env python3
"""Restricted local Home Assistant API for the Doover bridge app."""

from __future__ import annotations

import argparse
import hmac
import json
import logging
import os
import re
import urllib.error
import urllib.request
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from typing import Any


LOGGER = logging.getLogger("doover.home_assistant_bridge")
ENTITY_ID_PATTERN = re.compile(r"^(sensor|binary_sensor|light)\.[a-z0-9_]+$")
LIGHT_COMMANDS = frozenset({"turn_on", "turn_off", "toggle"})
SAFE_ATTRIBUTES = frozenset(
    {"device_class", "friendly_name", "icon", "unit_of_measurement"}
)
MAX_BODY_BYTES = 16_384
MAX_ENTITY_IDS = 100


class BridgeRequestError(Exception):
    def __init__(self, status: HTTPStatus, message: str):
        self.status = status
        self.message = message
        super().__init__(message)


class HomeAssistantError(Exception):
    pass


def load_options(path: Path) -> dict[str, Any]:
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise RuntimeError(f"Could not read Home Assistant app options: {exc}") from exc
    if not isinstance(data, dict):
        raise RuntimeError("Home Assistant app options must be a JSON object")
    return data


def bridge_is_enabled(options: dict[str, Any]) -> bool:
    return options.get("homeassistant_bridge_enabled") is True


def validate_bridge_token(value: Any) -> str:
    if not isinstance(value, str) or len(value) < 32:
        raise RuntimeError(
            "Home Assistant bridge credential must contain at least 32 characters"
        )
    return value


def validate_entity_ids(value: Any) -> list[str]:
    if not isinstance(value, list) or not 1 <= len(value) <= MAX_ENTITY_IDS:
        raise BridgeRequestError(
            HTTPStatus.BAD_REQUEST,
            f"entity_ids must contain between 1 and {MAX_ENTITY_IDS} items",
        )
    result: list[str] = []
    seen: set[str] = set()
    for entity_id in value:
        if not isinstance(entity_id, str) or not ENTITY_ID_PATTERN.fullmatch(entity_id):
            raise BridgeRequestError(
                HTTPStatus.BAD_REQUEST, f"Unsupported entity ID: {entity_id!r}"
            )
        if entity_id not in seen:
            seen.add(entity_id)
            result.append(entity_id)
    return result


def sanitize_state(state: dict[str, Any]) -> dict[str, Any]:
    attributes = state.get("attributes")
    if not isinstance(attributes, dict):
        attributes = {}
    return {
        "entity_id": state.get("entity_id"),
        "state": state.get("state"),
        "last_changed": state.get("last_changed"),
        "last_updated": state.get("last_updated"),
        "attributes": {
            key: attributes[key] for key in SAFE_ATTRIBUTES if key in attributes
        },
    }


class HomeAssistantClient:
    def __init__(self, base_url: str, token: str, timeout: float = 10.0):
        self.base_url = base_url.rstrip("/")
        self.token = token
        self.timeout = timeout

    def _request(self, path: str, payload: dict[str, Any] | None = None) -> Any:
        data = None
        headers = {"Authorization": f"Bearer {self.token}"}
        method = "GET"
        if payload is not None:
            data = json.dumps(payload, separators=(",", ":")).encode()
            headers["Content-Type"] = "application/json"
            method = "POST"
        request = urllib.request.Request(
            f"{self.base_url}{path}", data=data, headers=headers, method=method
        )
        try:
            with urllib.request.urlopen(request, timeout=self.timeout) as response:
                body = response.read()
        except (urllib.error.URLError, TimeoutError) as exc:
            raise HomeAssistantError(f"Home Assistant request failed: {exc}") from exc
        try:
            return json.loads(body) if body else None
        except json.JSONDecodeError as exc:
            raise HomeAssistantError("Home Assistant returned invalid JSON") from exc

    def query_entities(self, entity_ids: list[str]) -> dict[str, Any]:
        states = self._request("/states")
        if not isinstance(states, list):
            raise HomeAssistantError("Home Assistant states response was not a list")
        requested = set(entity_ids)
        readings = {
            state.get("entity_id"): sanitize_state(state)
            for state in states
            if isinstance(state, dict) and state.get("entity_id") in requested
        }
        return {
            "entities": [readings[item] for item in entity_ids if item in readings],
            "missing": [item for item in entity_ids if item not in readings],
        }

    def command_light(self, entity_id: Any, command: Any) -> dict[str, Any]:
        if not isinstance(entity_id, str) or not ENTITY_ID_PATTERN.fullmatch(entity_id):
            raise BridgeRequestError(HTTPStatus.BAD_REQUEST, "Invalid entity_id")
        if not entity_id.startswith("light."):
            raise BridgeRequestError(
                HTTPStatus.FORBIDDEN, "Only light entities can receive commands"
            )
        if command not in LIGHT_COMMANDS:
            raise BridgeRequestError(HTTPStatus.FORBIDDEN, "Unsupported light command")
        self._request(f"/services/light/{command}", {"entity_id": entity_id})
        return {"entity_id": entity_id, "command": command}


class BridgeServer(ThreadingHTTPServer):
    daemon_threads = True

    def __init__(
        self,
        server_address: tuple[str, int],
        bridge_token: str,
        home_assistant: HomeAssistantClient,
    ):
        super().__init__(server_address, BridgeHandler)
        self.bridge_token = bridge_token
        self.home_assistant = home_assistant


class BridgeHandler(BaseHTTPRequestHandler):
    server: BridgeServer

    def log_message(self, message: str, *args: Any) -> None:
        LOGGER.info("%s - %s", self.client_address[0], message % args)

    def _write_json(self, status: HTTPStatus, payload: dict[str, Any]) -> None:
        body = json.dumps(payload, separators=(",", ":")).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _authorize(self) -> None:
        supplied = self.headers.get("Authorization", "")
        expected = f"Bearer {self.server.bridge_token}"
        if not hmac.compare_digest(supplied, expected):
            raise BridgeRequestError(HTTPStatus.UNAUTHORIZED, "Unauthorized")

    def _read_json(self) -> dict[str, Any]:
        raw_length = self.headers.get("Content-Length")
        try:
            length = int(raw_length or "")
        except ValueError as exc:
            raise BridgeRequestError(
                HTTPStatus.BAD_REQUEST, "A valid Content-Length is required"
            ) from exc
        if not 1 <= length <= MAX_BODY_BYTES:
            raise BridgeRequestError(
                HTTPStatus.REQUEST_ENTITY_TOO_LARGE,
                "Request body is too large or empty",
            )
        try:
            value = json.loads(self.rfile.read(length))
        except json.JSONDecodeError as exc:
            raise BridgeRequestError(HTTPStatus.BAD_REQUEST, "Invalid JSON") from exc
        if not isinstance(value, dict):
            raise BridgeRequestError(
                HTTPStatus.BAD_REQUEST, "JSON body must be an object"
            )
        return value

    def do_GET(self) -> None:  # noqa: N802 - BaseHTTPRequestHandler API
        if self.path == "/health":
            self._write_json(HTTPStatus.OK, {"status": "ok"})
            return
        self._write_json(HTTPStatus.NOT_FOUND, {"error": "Not found"})

    def do_POST(self) -> None:  # noqa: N802 - BaseHTTPRequestHandler API
        try:
            self._authorize()
            body = self._read_json()
            if self.path == "/v1/entities/query":
                response = self.server.home_assistant.query_entities(
                    validate_entity_ids(body.get("entity_ids"))
                )
            elif self.path == "/v1/commands":
                response = self.server.home_assistant.command_light(
                    body.get("entity_id"), body.get("command")
                )
            else:
                raise BridgeRequestError(HTTPStatus.NOT_FOUND, "Not found")
            self._write_json(HTTPStatus.OK, response)
        except BridgeRequestError as exc:
            self._write_json(exc.status, {"error": exc.message})
        except HomeAssistantError as exc:
            LOGGER.warning("%s", exc)
            self._write_json(
                HTTPStatus.BAD_GATEWAY, {"error": "Home Assistant is unavailable"}
            )
        except Exception:
            LOGGER.exception("Unexpected bridge request failure")
            self._write_json(
                HTTPStatus.INTERNAL_SERVER_ERROR, {"error": "Internal server error"}
            )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser()
    parser.add_argument("--options", type=Path, default=Path("/data/options.json"))
    parser.add_argument("--check-enabled", action="store_true")
    parser.add_argument("--host", default="0.0.0.0")
    parser.add_argument("--port", type=int, default=49192)
    return parser


def main() -> int:
    args = build_parser().parse_args()
    options = load_options(args.options)
    if args.check_enabled:
        return 0 if bridge_is_enabled(options) else 1
    if not bridge_is_enabled(options):
        raise RuntimeError("Home Assistant bridge is disabled")
    bridge_token = validate_bridge_token(options.get("homeassistant_bridge_token"))
    supervisor_token = os.environ.get("SUPERVISOR_TOKEN")
    if not supervisor_token:
        raise RuntimeError(
            "SUPERVISOR_TOKEN is unavailable; set homeassistant_api: true"
        )

    logging.basicConfig(level=logging.INFO, format="[doover-bridge] %(message)s")
    client = HomeAssistantClient(
        os.environ.get("HOME_ASSISTANT_API", "http://supervisor/core/api"),
        supervisor_token,
    )
    server = BridgeServer((args.host, args.port), bridge_token, client)
    LOGGER.info("Listening on %s:%s", args.host, args.port)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
