#!/usr/bin/env python3
"""Validate Home Assistant options and render the Device Agent config."""

from __future__ import annotations

import hashlib
import ipaddress
import json
import os
import tempfile
from pathlib import Path
from typing import Any
from urllib.parse import urlparse


class ConfigurationError(ValueError):
    """A configuration error safe to show in the add-on log."""


CONFIGURED_AUTH_DIGEST_KEY = "_home_assistant_configured_auth_sha256"


def _text(options: dict[str, Any], key: str) -> str:
    value = options.get(key, "")
    if not isinstance(value, (str, int)):
        raise ConfigurationError(f"{key} must be text")
    return str(value).strip()


def _numeric_id(options: dict[str, Any], key: str) -> str:
    value = _text(options, key)
    if not value or not value.isdecimal():
        raise ConfigurationError(f"{key} must contain only digits")
    return value


def _url(options: dict[str, Any], key: str, schemes: set[str]) -> str:
    value = _text(options, key)
    parsed = urlparse(value)
    if parsed.scheme not in schemes or not parsed.hostname:
        expected = " or ".join(sorted(schemes))
        raise ConfigurationError(f"{key} must be a {expected} URL")
    return value.rstrip("/") if key == "data_api" else value


def _static_ips(options: dict[str, Any]) -> list[str]:
    raw = _text(options, "data_static_ips")
    if not raw:
        return []
    values = [part.strip() for part in raw.replace(",", " ").split()]
    try:
        return [str(ipaddress.ip_address(value)) for value in values]
    except ValueError as error:
        raise ConfigurationError(f"data_static_ips contains an invalid IP address: {error}") from error


def _boolean(options: dict[str, Any], key: str) -> bool:
    value = options.get(key, False)
    if not isinstance(value, bool):
        raise ConfigurationError(f"{key} must be true or false")
    return value


def _load_object(path: Path, *, required: bool) -> dict[str, Any]:
    if not path.exists():
        if required:
            raise ConfigurationError(f"configuration file does not exist: {path}")
        return {}
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise ConfigurationError(f"cannot read JSON configuration at {path}: {error}") from error
    if not isinstance(value, dict):
        raise ConfigurationError(f"JSON configuration at {path} must be an object")
    return value


def _token_for_config(
    configured_token: str,
    existing_config: dict[str, Any],
    previous_digest: str | None,
    current_digest: str,
) -> str:
    existing_token = existing_config.get("auth_token")

    if previous_digest == current_digest and isinstance(existing_token, str):
        return existing_token
    return configured_token


def _configured_auth_digest(token: str, client_id: str, client_secret: str) -> str:
    auth_input = json.dumps(
        {
            "auth_token": token,
            "client_id": client_id,
            "client_secret": client_secret,
        },
        sort_keys=True,
        separators=(",", ":"),
    )
    return hashlib.sha256(auth_input.encode("utf-8")).hexdigest()


def build_config(
    options: dict[str, Any],
    existing_config: dict[str, Any],
) -> dict[str, Any]:
    agent_id = _numeric_id(options, "agent_id")
    organisation_id = _numeric_id(options, "organisation_id")
    configured_token = _text(options, "auth_token")
    client_id = _text(options, "client_id")
    client_secret = _text(options, "client_secret")
    previous_digest = existing_config.get(CONFIGURED_AUTH_DIGEST_KEY)
    if not isinstance(previous_digest, str):
        previous_digest = None

    if not configured_token and not (client_id and client_secret):
        raise ConfigurationError(
            "set auth_token, or set both client_id and client_secret"
        )
    if bool(client_id) != bool(client_secret):
        raise ConfigurationError("client_id and client_secret must be set together")

    current_auth_digest = _configured_auth_digest(
        configured_token, client_id, client_secret
    )
    config: dict[str, Any] = {
        "agent_id": agent_id,
        "organisation_id": organisation_id,
        "auth_token": _token_for_config(
            configured_token,
            existing_config,
            previous_digest,
            current_auth_digest,
        ),
        "client_id": client_id,
        "client_secret": client_secret,
        "data_api": _url(options, "data_api", {"http", "https"}),
        "data_wss": _url(options, "data_wss", {"ws", "wss"}),
        "debug": _boolean(options, "debug"),
        "run_web_server": False,
        "port": 50051,
        CONFIGURED_AUTH_DIGEST_KEY: current_auth_digest,
    }
    static_ips = _static_ips(options)
    if static_ips:
        config["data_static_ips"] = static_ips
    return config


def _atomic_write(path: Path, content: str, mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary_path = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary_path, mode)
        os.replace(temporary_path, path)
    finally:
        temporary_path.unlink(missing_ok=True)


def main() -> int:
    options_path = Path(os.environ.get("OPTIONS_PATH", "/data/options.json"))
    config_path = Path(os.environ.get("AGENT_CONFIG_PATH", "/data/agent/config.json"))
    try:
        options = _load_object(options_path, required=True)
        existing_config = _load_object(config_path, required=False)
        config = build_config(options, existing_config)
        _atomic_write(config_path, json.dumps(config, indent=2) + "\n", 0o600)
    except ConfigurationError as error:
        print(f"[doover] Configuration error: {error}", flush=True)
        return 2

    print(f"[doover] Wrote Device Agent configuration for agent {config['agent_id']}", flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
